# Focused CPU-observation run for comparing GPUD (-x 0) vs CPU bounce (-x 2).
GDSIO=/usr/local/cuda-13.2/gds/tools/gdsio
TARGET_DIR=/mnt/nvme0
GPU_ID=0
RUNTIME=10
REPEATS=3
OUTPUT_ROOT=/home/poc/gds_bench/results
RUN_ID=cpu_observation_$(date +%Y%m%d_%H%M%S)
DATASET_ROOT=/mnt/nvme0/gdsio_cpu_observation_${RUN_ID}_gpu${GPU_ID}

X_FLAGS_STR="0 2"
PREPARE_DATASETS=1
PREP_X_FLAG=2
PREP_IO_SIZE=1M
PREP_DURATION=1
PREP_MIN_FILL_RATIO=0.95
PREP_MAX_ATTEMPTS=6

ENABLE_MPSTAT=1
ENABLE_PIDSTAT=1
ENABLE_IOSTAT=1
ENABLE_NVIDIA_DMON=0
ENABLE_NVFS_SAMPLER=0
ENABLE_GDS_STATS=0
SAVE_META=1

# Four focused workloads:
# 1. Sequential read, th8, 1M
# 2. Sequential read, th8, 4M
# 3. Sequential write, th8, 1M
# 4. Random write, th32, 4K
CPU_OBS_CASES_STR="seq:read:8:1G:1M seq:read:8:1G:4M seq:write:8:1G:1M rand:write:32:1G:4K"
