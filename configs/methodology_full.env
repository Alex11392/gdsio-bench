# Recommended full benchmark matrix based on NVIDIA's GDS benchmarking guidance.
GDSIO=/usr/local/cuda-13.2/gds/tools/gdsio
TARGET_DIR=/mnt/nvme0
GPU_ID=0
RUNTIME=120
REPEATS=3
VERIFY=0
OUTPUT_ROOT=/home/poc/gds_bench/results
RUN_ID=methodology_full_$(date +%Y%m%d_%H%M%S)

X_FLAGS_STR="0 2"
MODES_STR="read write"

# Large sequential IO for throughput.
SEQ_IO_SWEEP_THREADS=8
SEQ_IO_SIZES_STR="128K 256K 512K 1M 2M 4M"
SEQ_THREAD_SWEEP_IO_SIZE=1M
SEQ_THREADS_STR="1 2 4 8 16 32"
SEQ_DATASET_SIZE=1G

# Small random IO for IOPS/latency.
RAND_IO_SWEEP_THREADS=32
RAND_IO_SIZES_STR="4K 8K 16K 32K 64K 128K"
RAND_THREAD_SWEEP_IO_SIZE=4K
RAND_THREADS_STR="1 2 4 8 16 32"
RAND_DATASET_SIZE=1G
RAND_SEED=12345
RAND_USE_UNALIGNED=0
RAND_FILL_BUFFER=0

# Prepare files ahead of measurement so writes do not benchmark file creation.
PREPARE_DATASETS=1
PREP_X_FLAG=2
PREP_IO_SIZE=1M
PREP_DURATION=1

RESET_NVFS_STATS=1
SAVE_META=1
SAVE_CUFILE_LOGS=1
ENABLE_MPSTAT=1
ENABLE_PIDSTAT=1
ENABLE_IOSTAT=1
ENABLE_NVIDIA_DMON=1
ENABLE_NVFS_SAMPLER=1
ENABLE_GDS_STATS=1
