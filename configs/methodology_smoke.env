# Minimal validation matrix for the methodology-oriented runner.
GDSIO=/usr/local/cuda-13.2/gds/tools/gdsio
TARGET_DIR=/mnt/nvme0
GPU_ID=0
RUNTIME=15
REPEATS=1
VERIFY=0
OUTPUT_ROOT=/home/poc/gds_bench/results
RUN_ID=methodology_smoke_$(date +%Y%m%d_%H%M%S)

X_FLAGS_STR="0 2"
MODES_STR="read write"

SEQ_IO_SWEEP_THREADS=1
SEQ_IO_SIZES_STR="1M"
SEQ_THREAD_SWEEP_IO_SIZE=1M
SEQ_THREADS_STR="1"
SEQ_DATASET_SIZE=256M

RAND_IO_SWEEP_THREADS=1
RAND_IO_SIZES_STR="4K"
RAND_THREAD_SWEEP_IO_SIZE=4K
RAND_THREADS_STR="1"
RAND_DATASET_SIZE=256M
RAND_SEED=12345

PREPARE_DATASETS=1
PREP_X_FLAG=2
PREP_IO_SIZE=1M
PREP_DURATION=1

RESET_NVFS_STATS=1
ENABLE_MPSTAT=1
ENABLE_PIDSTAT=1
ENABLE_IOSTAT=1
ENABLE_NVIDIA_DMON=1
ENABLE_NVFS_SAMPLER=1
ENABLE_GDS_STATS=1
