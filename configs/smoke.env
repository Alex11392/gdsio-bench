# Minimal suite for environment validation.
GDSIO=/usr/local/cuda-13.2/gds/tools/gdsio
TARGET_DIR=/mnt/nvme0
GPU_ID=0
DURATION=3
VERIFY=0
OUTPUT_ROOT=/home/poc/gds_bench/results
RUN_ID=smoke_$(date +%Y%m%d_%H%M%S)

MODES_STR="write read"
X_FLAGS_STR="0 2"

IO_SWEEP_THREADS=1
IO_SWEEP_THROUGHPUT_SIZES_STR="1M"
IO_SWEEP_LATENCY_SIZES_STR="4K"

THREAD_SWEEP_THROUGHPUT_IO_SIZE=1M
THREAD_SWEEP_LATENCY_IO_SIZE=4K
THREAD_SWEEP_THREADS_STR="1"

DATASET_SIZE_THROUGHPUT=64M
DATASET_SIZE_LATENCY=64M

CLEAN_CASE_DATASET=0
CLEAN_RUN_DATASET_ON_EXIT=0
FAIL_FAST=1
RESET_NVFS_STATS=1

